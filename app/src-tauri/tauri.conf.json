{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bluprint",
  "version": "0.1.0",
  "identifier": "dev.bluprint.app",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "http://localhost:3123",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Bluprint",
        "width": 1512,
        "height": 900,
        "minWidth": 480,
        "minHeight": 400,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "Entitlements.plist",
      "minimumSystemVersion": "11.0"
    }
  }
}
